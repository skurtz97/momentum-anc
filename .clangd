CompileFlags:
  # meson writes build/compile_commands.json
  CompilationDatabase: build
  Add:
    - -D_GNU_SOURCE

Diagnostics:
  # gtk.h is a deliberate umbrella header; don't nag about it
  UnusedIncludes: None
  MissingIncludes: None

Index:
  Background: Build

InlayHints:
  Enabled: true
  ParameterNames: true
  Designators: true
